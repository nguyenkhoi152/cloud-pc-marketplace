# MẪU biến môi trường cho demo phiên thuê với ví GIẢ LẬP + chuỗi Hardhat CỤC BỘ (không phải Fuji). Sao chép thành file ngoài repo (ví dụ %TEMP%\localchain.env.sh) rồi điền.
# Khoá dưới đây là khoá Hardhat CÔNG KHAI (vô giá trị, chỉ có nghĩa trên chuỗi cục bộ). KHÔNG dùng khoá thật ở đây.
# Địa chỉ PCP/ESCROW lấy từ contracts/deployments/localhost.json SAU MỖI LẦN deploy (node Hardhat không lưu trạng thái: mỗi lần khởi động là chuỗi mới).
export RPC_URL=http://127.0.0.1:8545
export ESCROW_ADDRESS=<từ deployments/localhost.json>
export PCP_ADDRESS=<từ deployments/localhost.json>
export TREASURY_ADDRESS=0x9965507d1a55bcc2695c58ba16fb37d819b0a4dc        # Hardhat #5 (vai trò treasury của deploy cục bộ)
export QUOTE_SIGNER_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6   # Hardhat #3 (công khai); LƯU Ý khoá #2 là 0x5de4…, đừng nhầm
export OPERATOR_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d        # Hardhat #1 (công khai)
export ESCROW_DEPLOY_BLOCK=0
export MIN_CONFIRMATIONS=1
export WALLET_DOMAIN=localhost:3000
export WALLET_URI=http://localhost:3000
export ALLOWED_ORIGINS=http://tauri.localhost,http://127.0.0.1:5174,http://localhost:5174
export WORKSPACE_DIR=C:/cpm-ws-dev
export WORKER_PROVIDER=agent
export AGENT_COMMAND_TIMEOUT_MS=60000
export AGENT_COMMAND_POLL_MS=500
