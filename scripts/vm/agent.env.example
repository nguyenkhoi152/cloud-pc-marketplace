# MẪU biến môi trường host-agent cho demo (guest Docker qua SSH tới VM thử). Giá trị có dấu cách PHẢI đặt trong dấu nháy kép.
export AGENT_API_BASE=http://127.0.0.1:3000/api
export AGENT_DATA_DIR=C:/cpm-demo/agent          # chứa credential.json (do session-setup.mts tạo) và guest-state.json
export AGENT_INTERVAL_MS=2000
export GATEWAY_UPSTREAM=http://127.0.0.1:18080    # cổng Selkies trong VM đã chuyển tiếp về loopback
export GATEWAY_PUBLIC_URL=http://127.0.0.1:18095
export GATEWAY_PORT=18095
export GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:18095
export GATEWAY_FRAME_ANCESTORS=http://tauri.localhost,http://127.0.0.1:5174,http://localhost:5174
export GUEST_MODE=docker
export GUEST_DOCKER_IMAGE=<ghcr.io/selkies-project/selkies/desktop@sha256:... lấy bằng: docker image inspect --format '{{index .RepoDigests 0}}' <tag>>
export GUEST_DOCKER_SSH_TARGET=cpm@127.0.0.1
export GUEST_DOCKER_SSH_PORT=2222
export GUEST_DOCKER_SSH_KEY="C:/Users/<bạn>/VirtualBox VMs/_secrets/cpm-test-host.ed25519"
export GUEST_DOCKER_SSH_KNOWN_HOSTS=<đường dẫn KHÔNG có dấu cách tới file known_hosts đã ghim khoá VM>
