# Chỉ placeholder. Copy thành web/.env.local (Next chỉ đọc file trong thư mục web/; đã bị Git bỏ qua).
# Mọi biến dưới đây là SERVER-ONLY (không có tiền tố NEXT_PUBLIC_): không bao giờ vào bundle trình duyệt/app.
#
# QUY TẮC ĐỊNH DẠNG: mỗi dòng chỉ là TÊN=GIÁ_TRỊ. Không để chú thích cùng dòng, không lặp lại tên biến trong giá trị,
# không đặt dấu nháy hay khoảng trắng thừa. Chú thích nằm ở dòng riêng bắt đầu bằng #.
# Kiểm tra (không in giá trị): npm run check:env

# --- Supabase (công khai) ---
# SUPABASE_URL có dạng https://<project-ref>.supabase.co (không có đường dẫn phía sau).
SUPABASE_URL=
# SUPABASE_ANON_KEY: key publishable/anon, chỉ dùng để xác thực người dùng qua /auth/v1/user.
SUPABASE_ANON_KEY=

# --- Postgres (BÍ MẬT: chứa mật khẩu DB) ---
# SUPABASE_DB_URL: chuỗi kết nối Session pooler/direct; server `set local role service_role` trong từng transaction.
SUPABASE_DB_URL=
# (Tuỳ chọn) SUPABASE_DB_CA: đường dẫn file PEM của CA Supabase nếu Node báo "self-signed certificate in certificate chain".
# Tìm mục SSL/CA certificate trong cài đặt Database của dashboard (tên menu có thể đổi).
# SUPABASE_DB_CA=
# PHƯƠNG ÁN CUỐI (không xác minh chứng chỉ, rủi ro MITM): chỉ để thử, ưu tiên SUPABASE_DB_CA.
# SUPABASE_DB_SSL=no-verify

# --- Chuỗi (Fuji testnet) ---
CHAIN_ID=43113
# RPC_URL: RPC Fuji (không phải mainnet).
RPC_URL=
# ESCROW_ADDRESS: RentalEscrow đã deploy.
ESCROW_ADDRESS=
# PCP_ADDRESS: PCP đã deploy.
PCP_ADDRESS=
# TREASURY_ADDRESS: trùng treasury cấu hình trong escrow.
TREASURY_ADDRESS=
# CONFIG_VERSION: phải khớp escrow.configVersion.
CONFIG_VERSION=1
MIN_CONFIRMATIONS=2

# --- Khoá ký (BÍ MẬT, chỉ server) ---
# QUOTE_SIGNER_PRIVATE_KEY: 0x + 64 hex; địa chỉ tương ứng phải là quote signer đã cấu hình trong escrow.
QUOTE_SIGNER_PRIVATE_KEY=
# Chỉ worker (cần OPERATOR_ROLE trên escrow); KHÔNG đặt trong web/.env.local nếu worker chạy riêng.
# OPERATOR_PRIVATE_KEY=

# --- Ví / CORS ---
# WALLET_DOMAIN: ví dụ app.example.com (đưa vào thông điệp ký).
WALLET_DOMAIN=
# WALLET_URI: ví dụ https://app.example.com
WALLET_URI=
# ALLOWED_ORIGINS: origin của app/dev được gọi API, cách nhau bằng dấu phẩy (ví dụ http://localhost:5174).
ALLOWED_ORIGINS=

# --- Chuỗi công khai + vòi testnet (tuỳ chọn; để người thử trên máy khác có ví và PCP thử) ---
# PUBLIC_RPC_URL: RPC CÔNG KHAI app dùng để đọc/ký giao dịch (Fuji: https://api.avax-test.network/ext/bc/C/rpc). Không đặt URL có khoá API riêng.
# Nếu RPC_URL là loopback (chuỗi cục bộ) thì tự dùng RPC_URL.
# PUBLIC_RPC_URL=
# FAUCET_PRIVATE_KEY: khoá có ISSUER_ROLE trên PCP và một ít AVAX testnet (BÍ MẬT, chỉ server). Bật route POST /api/faucet:
# mint PCP thử một lần/ví và nhỏ giọt một ít AVAX gas một lần/24 giờ/ví. Không đặt thì vòi tắt.
# FAUCET_PRIVATE_KEY=
# FAUCET_GAS_AVAX: lượng AVAX gas mỗi lần nhỏ giọt (mặc định 0.05).
# FAUCET_GAS_AVAX=0.05

# --- Workspace dev (tuỳ chọn) ---
# Thư mục cục bộ cho LocalFsStore (CHỈ dev; không dùng filesystem của Vercel cho dữ liệu bền vững).
# WORKSPACE_DIR=
