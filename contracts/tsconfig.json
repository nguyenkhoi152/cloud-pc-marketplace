{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "test",
    "scripts",
    "hardhat.config.ts",
    "artifacts/**/*.d.ts",
    "types/**/*.d.ts"
  ]
}