# Chỉ placeholder. Biến VITE_* bị NHÚNG vào bundle của app => CHỈ đặt giá trị công khai.
# KHÔNG BAO GIỜ đặt service-role/secret key, mật khẩu DB hay khoá ký ở đây.
# Copy thành desktop/.env.local (đã bị Git bỏ qua) khi dùng chế độ live.
VITE_APP_MODE=preview               # preview (mock, có nhãn) | live (API thật, không fallback mock)
VITE_SUPABASE_URL=                  # https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=             # khoá công khai (anon / publishable)
VITE_API_BASE_URL=                  # tuỳ chọn: https://<web>/api (server API: ví, quote, nhận đường dẫn xem); http://localhost:3000/api khi dev
