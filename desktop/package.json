{
  "name": "@cpm/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloud PC Companion — app desktop (preview mô phỏng hoặc live với Supabase dev; vỏ Tauri trong src-tauri)",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5175 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "tauri": "tauri",
    "smoke:supabase": "vitest run --mode smoke --config vitest.smoke.config.ts",
    "bundle:agent": "node ../host-agent/scripts/bundle.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "motion": "14.10.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "viem": "2.57.16",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
